<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="mb-0">Tasks</h1>
      <p class="text-muted mb-0">A simple list of tasks in the system</p>
    </div>
    <div>
      <!-- routes currently expose only index; keep action button disabled for now -->
      <button class="btn btn-primary" disabled>New Task (coming soon)</button>
    </div>
  </div>

  <% if flash.any? %>
    <% flash.each do |type, message| %>
      <% bs_class = case type.to_sym
        when :notice then 'success'
        when :alert then 'danger'
        else 'info'
      end %>
      <div class="alert alert-<%= bs_class %> alert-dismissible fade show" role="alert">
        <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>
  <% end %>

  <% if @tasks.any? %>
    <div class="row row-cols-1 row-cols-md-2 g-3">
      <% @tasks.each do |task| %>
        <div class="col">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title"><%= task.title %></h5>
              <p class="card-text text-muted mb-1"><small>Created: <%= task.created_at.strftime("%Y-%m-%d %H:%M") %></small></p>
              <p class="card-text text-muted mb-0"><small>Updated: <%= task.updated_at.strftime("%Y-%m-%d %H:%M") %></small></p>
            </div>
            <%# optional footer for future actions %>
            <div class="card-footer bg-transparent border-0">
              <small class="text-muted">ID: <%= task.id %></small>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-secondary" role="alert">
      No tasks yet. Create one soon!
    </div>
  <% end %>
</div>
